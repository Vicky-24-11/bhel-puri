# Bhel Puri - Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase project details.

# Public Supabase API credentials (exposed to client-side code)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
